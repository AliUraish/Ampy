{
  "manifest_version": 3,
  "name": "Hagglr — Facebook Marketplace bridge",
  "version": "0.1.0",
  "description": "Lets your local Hagglr buyer agent search Facebook Marketplace using your own signed-in browser session.",
  "permissions": ["scripting", "tabs", "storage"],
  "host_permissions": [
    "https://www.facebook.com/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": { "default_popup": "popup.html", "default_title": "Hagglr bridge" }
}
