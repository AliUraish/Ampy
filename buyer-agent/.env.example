# Anthropic API key used for negotiation agents, floor-price estimation, and
# seller-photo vision detection. Get one at https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...

# Port the Express server listens on.
PORT=3000

# When "true", GET /api/search always uses data/listings.js instead of
# attempting a live Craigslist fetch. Useful for demos, offline dev, or when
# Craigslist is blocking/rate-limiting requests. Also used automatically as
# a fallback if a live fetch fails or returns zero results.
USE_MOCK_DATA=false

# Craigslist subdomain to search by default (e.g. sfbay, newyork, losangeles,
# chicago). Can be overridden per-request via the `location` query param.
CRAIGSLIST_LOCATION=sfbay

# Telegram bot for low-traction repost/price-drop alerts (lib/repostScheduler.js).
# Both optional — the whole feature no-ops with a log message if either is
# unset, so the app runs fine without a Telegram bot configured.
#
# TELEGRAM_BOT_TOKEN: message @BotFather on Telegram, send /newbot, follow
#   the prompts — it gives you a token like "123456:ABC-DEF...".
# TELEGRAM_CHAT_ID: message your new bot anything at all, then open
#   https://api.telegram.org/bot<TELEGRAM_BOT_TOKEN>/getUpdates in a browser
#   and read `message.chat.id` from the JSON response.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Buyer agent -----------------------------------------------------------

# The seller agent the buyer agent talks to — asks questions of, and haggles
# with. See "THE SELLER-AGENT CONTRACT" in lib/sellerChannel.js for the two
# endpoints it must expose (POST /ask and POST /negotiate).
#
# Unset, the buyer agent falls back to iMessage for sellers who published a
# phone number, and reports the rest as unreachable.
#
# To try it without the real seller agent, run the reference implementation:
#   node tools/mockSellerAgent.js
#   SELLER_AGENT_URL=http://localhost:4000 npm start
SELLER_AGENT_URL=
SELLER_AGENT_TIMEOUT_MS=15000

# Which listings the seller agent speaks for.
#   all     (default) every listing the buyer agent finds — the integrated setup
#   hagglr  only listings posted through /sell
SELLER_AGENT_SCOPE=all

# --- Facebook Marketplace (via the Chrome extension) ------------------------

# Marketplace has no buyer-side API, so Hagglr reads it through a Chrome
# extension running in YOUR signed-in browser (see extension/ and
# lib/extensionBridge.js). Set this true AND load the extension, or the
# source stays off.
ENABLE_FACEBOOK=false
FB_EXTENSION_TIMEOUT_MS=25000

# --- iMessage (macOS only) --------------------------------------------------

# true = the agent logs messages instead of delivering them. Use this while
# developing so test runs don't text real sellers.
IMESSAGE_DRY_RUN=false

# Autonomy guardrails. The agent sends without asking, so these bound the
# damage from a bad loop or a misparsed phone number.
IMESSAGE_MAX_PER_SELLER_PER_DAY=3
IMESSAGE_MAX_PER_DAY=40
