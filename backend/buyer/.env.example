# Same names as the repo-root .env used by both Ampy agents.
# backend/buyer loads ../../.env first, then a local .env if you add one.

MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-medium-latest
MISTRAL_SEARCH_TOOL=web_search

# Optional buyer-only settings (not required if the root .env is present).
# MISTRAL_VISION_MODEL=mistral-medium-latest
# MISTRAL_MIN_INTERVAL_MS=1100
# PORT=3000
# USE_MOCK_DATA=false
# CRAIGSLIST_LOCATION=sfbay
# Defaults to http://127.0.0.1:8000 when unset. Set to empty to disable.
# SELLER_AGENT_URL=http://127.0.0.1:8000
# SELLER_AGENT_TIMEOUT_MS=15000
# SELLER_AGENT_SCOPE=all
# ENABLE_FACEBOOK=false
# IMESSAGE_DRY_RUN=false
